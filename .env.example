# ── Google Cloud / Vertex AI ───────────────────────────────────────────────────
# Project ID and region for Vertex AI (Gemini 2.5 Flash)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# ── Elasticsearch Serverless ───────────────────────────────────────────────────
# HTTPS endpoint for your Elastic Cloud Serverless project
ELASTIC_ENDPOINT=https://your-deployment-id.us-central1.gcp.cloud.es.io

# Encoded API key (base64 id:secret) — create one in Kibana > Stack Management > API Keys
# Set "Unrestricted IP" when creating the key if deploying to Cloud Run
ELASTIC_API_KEY=your-base64-encoded-api-key

# ── Elastic MCP (leave blank for local Docker / bundled binary mode) ───────────
# Set to the Cloud Run URL of a separately deployed Elastic MCP HTTP service.
# Leave empty to use the bundled binary (production) or Docker (local dev).
ELASTIC_MCP_URL=

# ── Outbound Webhook ───────────────────────────────────────────────────────────
# Endpoint that receives structured trading desk alerts when score >= 7.5.
# Defaults to httpbin.org/post for testing.
TRADING_DESK_WEBHOOK_URL=https://httpbin.org/post